# Copy to .env (gitignored, never commit real values) and fill in.
# Load with: source .env

# Local Postgres credentials, only needed if they differ from the
# postgres/postgres default already baked into config/dev.exs and
# config/test.exs.
DB_USERNAME=postgres
DB_PASSWORD=

# Required for Parallax.Stories.Gemini (Story grouping). Get a free key
# at https://aistudio.google.com/apikey
GEMINI_API_KEY=
